{
  "dashboard": {
    "title": "Distributed Agent Platform - Testing Metrics",
    "tags": ["testing", "agents", "distributed"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Document Count by Node",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "couchdb_node_documents",
            "legendFormat": "{{node}} - {{type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Documents"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Active Replications",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "couchdb_active_replications",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto"
        }
      },
      {
        "id": 3,
        "title": "Data Generation Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "rate(data_generation_total[5m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Replication Status",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "couchdb_replication_status",
            "legendFormat": "{{source}} → {{target}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Data Generation Duration",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "data_generation_duration_seconds",
            "legendFormat": "Generation Time",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(admin_api_requests_total[1m])",
            "legendFormat": "{{endpoint}} - {{method}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Total Documents (All Nodes)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(couchdb_node_documents)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 8,
        "title": "Agents by Status",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "targets": [
          {
            "expr": "couchdb_node_documents{type=\"agent\"}",
            "legendFormat": "{{node}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Tasks by Status",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "targets": [
          {
            "expr": "couchdb_node_documents{type=\"task\"}",
            "legendFormat": "{{node}}",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "version": 1
  }
}
